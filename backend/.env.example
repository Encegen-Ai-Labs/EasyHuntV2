SUPABASE_URL=URL
SUPABASE_KEY=key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-supabase-project-jwt-secret-key-found-in-settings
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Gemini (paid) — document extraction, VLM fallback for handwritten pages,
# and embeddings only. See app/services/llm_extractor.py.
GEMINI_API_KEY=your-gemini-api-key

# Google Cloud Translation API v2/Basic (free tier) — page-text-to-English only.
# Deliberately separate from GEMINI_API_KEY to keep translation off the paid
# extraction model. See app/services/translation_service.py.
GOOGLE_TRANSLATE_API_KEY=your-google-translate-api-key

# Optional durable document queue. Enable only when Redis and a Celery worker
# are running; docker-compose.yml enables this automatically for the API.
CELERY_ENABLED=false
CELERY_BROKER_URL=redis://localhost:6379/0
# Documents per worker at once (hard-capped at 6 in code). Worst-case Gemini
# calls in flight = workers x this x 4 pages.
CELERY_WORKER_CONCURRENCY=3
# Browser origins allowed to call the API, comma separated (CORS).
CORS_ORIGINS=http://localhost:3000

# ---- Environment and safety ----
# development | staging | production. Production refuses to start on placeholder
# secrets, an open CORS list, or localhost origins (see app/core/startup_checks.py).
APP_ENV=development
# Signs login tokens. Use a long random value that is NOT the Supabase JWT secret:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_JWT_SECRET=<generate-a-long-random-value>
# json (one JSON object per log line) or text. Default: json in staging/production.
LOG_FORMAT=text
# Error tracking (optional). Request bodies, headers and document text are never sent.
SENTRY_DSN=
# Set true only behind a reverse proxy you control (client address from X-Forwarded-For).
TRUST_PROXY=false

# ---- Rate limits (per client address, or per user for the paid calls) ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_UPLOAD=20/minute
RATE_LIMIT_PAID_CALLS=20/minute
RATE_LIMIT_DEFAULT=1200/minute

# ---- Cost tracking ----
# Estimated prices in US dollars per million tokens. CHECK THESE against Google's
# price list for the model in use; the usage screen shows estimates, not a bill.
LLM_PRICE_INPUT_PER_M=0.10
LLM_PRICE_OUTPUT_PER_M=0.40
LLM_PRICE_EMBEDDING_PER_M=0.15
TRANSLATE_PRICE_PER_M_CHARS=20
# Stops new uploads, translations and report drafts once today's estimated spend
# reaches this many dollars. 0 = no limit.
DAILY_LLM_BUDGET_USD=0

# ---- Translation ----
# auto: Google Cloud Translation if GOOGLE_TRANSLATE_API_KEY works, otherwise Gemini.
# google | gemini force one.
TRANSLATION_PROVIDER=auto
