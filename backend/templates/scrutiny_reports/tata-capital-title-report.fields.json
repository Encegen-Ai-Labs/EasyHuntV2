{
  "template": "tata-capital-title-report.docx",
  "bank": "Tata Capital",
  "engine": "docxtpl (render with autoescape=True)",
  "policy": {
    "source_values": {
      "extracted": "pulled from the case documents by extraction",
      "drafted": "proposed by the system or written by the lawyer; always reviewed and confirmed by the lawyer",
      "case_intake": "entered when the case is created or the report is issued",
      "search_office": "taken from the Sub-Registrar / IGR search",
      "profile": "the advocate's profile (name, place of signing)"
    },
    "review_levels": {
      "must_confirm": "Legal judgement (opinion, marketability, adverse or critical remarks, tenure, SARFAESI enforceability, claims, permissions). Never auto-confirmed: a lawyer must explicitly confirm or write the value. No positive wording is drafted while the case has open red flags.",
      "glance": "Factual checklist answer, letterhead, party or search detail that can be pre-filled from the extracted documents and shown for a quick lawyer check."
    },
    "rules": [
      "A must_confirm field is never auto-confirmed: a lawyer must explicitly confirm or write its value.",
      "The system must not draft \"clear and marketable\", \"no adverse entry\", \"enforceable\" or similar favourable wording for a must_confirm field while the case has open red flags.",
      "A glance field may be pre-filled from extracted documents but is still shown to the lawyer for a quick check before the report is issued.",
      "An unset field renders as empty text; no conclusion text is hard-coded in the template."
    ]
  },
  "lawyer_review_required": [
    "chain_steps",
    "critical_remarks",
    "govt_grant_status",
    "land_use_status",
    "leasehold_terms_details",
    "litigation_status",
    "local_laws_effect",
    "minor_claims",
    "mortgage_approval_status",
    "municipal_limits_status",
    "municipal_mutation_status",
    "mutation_extract_status",
    "na_conversion_status",
    "opinion_conclusion",
    "property_tax_payment_status",
    "property_tenure",
    "sanctions_reviewed_status",
    "sarfaesi_conclusion",
    "search_conclusion",
    "stamp_duty_status",
    "title_status"
  ],
  "must_confirm_fields": [
    "critical_remarks",
    "govt_grant_status",
    "leasehold_terms_details",
    "litigation_status",
    "local_laws_effect",
    "minor_claims",
    "mortgage_approval_status",
    "na_conversion_status",
    "opinion_conclusion",
    "property_tenure",
    "sanctions_reviewed_status",
    "sarfaesi_conclusion",
    "search_conclusion",
    "title_status"
  ],
  "notes": [
    "Built from one flat case and tested at a leasehold-plot case's entry counts; one template serves both."
  ],
  "open_questions": [
    "The signature block is 'For ____________________' with no advocate name and no Place line, so there is no advocate_name or advocate_place field. Should the blank be replaced by advocate_name?"
  ],
  "fields": [
    {
      "name": "bank_branch",
      "type": "text",
      "required": true,
      "source": "case_intake",
      "description": "Bank branch or city the report is addressed to",
      "review_level": "glance"
    },
    {
      "name": "borrower_name",
      "type": "text",
      "required": true,
      "source": "case_intake",
      "description": "Borrower name(s)",
      "review_level": "glance"
    },
    {
      "name": "co_borrower_names",
      "type": "text",
      "required": false,
      "source": "case_intake",
      "description": "Co-borrower name(s); leave empty if none",
      "review_level": "glance"
    },
    {
      "name": "critical_remarks",
      "type": "text",
      "required": true,
      "source": "drafted",
      "description": "Critical remarks / observations; no default",
      "review_level": "must_confirm",
      "auto_confirm": false,
      "draft_blocked_when_open_red_flags": true
    },
    {
      "name": "govt_grant_status",
      "type": "text",
      "required": true,
      "source": "drafted",
      "description": "Q10 government grant",
      "review_level": "must_confirm",
      "auto_confirm": false,
      "draft_blocked_when_open_red_flags": true
    },
    {
      "name": "land_use_status",
      "type": "text",
      "required": true,
      "source": "drafted",
      "description": "Q8 permitted land use",
      "review_level": "glance"
    },
    {
      "name": "leasehold_terms_details",
      "type": "text",
      "required": true,
      "source": "drafted",
      "description": "Q6 leasehold particulars",
      "review_level": "must_confirm",
      "auto_confirm": false,
      "draft_blocked_when_open_red_flags": true
    },
    {
      "name": "litigation_status",
      "type": "text",
      "required": true,
      "source": "drafted",
      "description": "Q11 litigation",
      "review_level": "must_confirm",
      "auto_confirm": false,
      "draft_blocked_when_open_red_flags": true
    },
    {
      "name": "loan_product",
      "type": "text",
      "required": false,
      "source": "case_intake",
      "description": "Purpose of loan / product (e.g. LAP, Secured Education Loan)",
      "review_level": "glance"
    },
    {
      "name": "local_laws_effect",
      "type": "text",
      "required": true,
      "source": "drafted",
      "description": "Q4 affected by local laws",
      "review_level": "must_confirm",
      "auto_confirm": false,
      "draft_blocked_when_open_red_flags": true
    },
    {
      "name": "minor_claims",
      "type": "text",
      "required": true,
      "source": "drafted",
      "description": "Q1 minor's interest/claim",
      "review_level": "must_confirm",
      "auto_confirm": false,
      "draft_blocked_when_open_red_flags": true
    },
    {
      "name": "mortgage_approval_status",
      "type": "text",
      "required": true,
      "source": "drafted",
      "description": "Q7 other permissions required",
      "review_level": "must_confirm",
      "auto_confirm": false,
      "draft_blocked_when_open_red_flags": true
    },
    {
      "name": "mortgage_type",
      "type": "choice",
      "required": true,
      "source": "case_intake",
      "description": "Type of mortgage to be created (printed in headings; Tata prints it upper-case)",
      "options": [
        "Equitable",
        "Registered",
        "Equitable/Registered"
      ],
      "review_level": "glance"
    },
    {
      "name": "mortgagor_name",
      "type": "text",
      "required": true,
      "source": "extracted",
      "description": "Mortgagor / owner name(s) as they should read in the opinion",
      "review_level": "glance"
    },
    {
      "name": "municipal_limits_status",
      "type": "text",
      "required": true,
      "source": "drafted",
      "description": "Q2 within municipal limits",
      "review_level": "glance"
    },
    {
      "name": "municipal_mutation_status",
      "type": "text",
      "required": true,
      "source": "drafted",
      "description": "Q14 mutated in municipal records",
      "review_level": "glance"
    },
    {
      "name": "mutation_extract_status",
      "type": "text",
      "required": true,
      "source": "drafted",
      "description": "Q13 mutated in revenue records",
      "review_level": "glance"
    },
    {
      "name": "na_conversion_status",
      "type": "text",
      "required": true,
      "source": "drafted",
      "description": "Q9 land conversion permission",
      "review_level": "must_confirm",
      "auto_confirm": false,
      "draft_blocked_when_open_red_flags": true
    },
    {
      "name": "opinion_conclusion",
      "type": "text",
      "required": true,
      "source": "drafted",
      "description": "Remainder of the opinion after the ownership clause: title, mortgage ability, enforceability, any conditions",
      "review_level": "must_confirm",
      "auto_confirm": false,
      "draft_blocked_when_open_red_flags": true
    },
    {
      "name": "property_description",
      "type": "text",
      "required": true,
      "source": "extracted",
      "description": "Full property description paragraph, including boundaries if any",
      "review_level": "glance"
    },
    {
      "name": "property_tax_payment_status",
      "type": "text",
      "required": true,
      "source": "drafted",
      "description": "Q3 taxes/charges paid",
      "review_level": "glance"
    },
    {
      "name": "property_tenure",
      "type": "choice",
      "required": true,
      "source": "drafted",
      "description": "Freehold/leasehold; also drives the opinion wording (only Freehold and Leasehold produce an ownership clause)",
      "options": [
        "Freehold",
        "Leasehold",
        "Govt. land",
        "Others"
      ],
      "review_level": "must_confirm",
      "auto_confirm": false,
      "draft_blocked_when_open_red_flags": true
    },
    {
      "name": "reference_number",
      "type": "text",
      "required": true,
      "source": "case_intake",
      "description": "Firm/bank reference number printed on the report",
      "review_level": "glance"
    },
    {
      "name": "report_date",
      "type": "date",
      "required": true,
      "source": "case_intake",
      "description": "Date of the report",
      "review_level": "glance"
    },
    {
      "name": "sanctions_reviewed_status",
      "type": "text",
      "required": true,
      "source": "drafted",
      "description": "Q12 sanctions/permissions/plans reviewed",
      "review_level": "must_confirm",
      "auto_confirm": false,
      "draft_blocked_when_open_red_flags": true
    },
    {
      "name": "sarfaesi_conclusion",
      "type": "text",
      "required": true,
      "source": "drafted",
      "description": "Q16 enforceable under SARFAESI",
      "review_level": "must_confirm",
      "auto_confirm": false,
      "draft_blocked_when_open_red_flags": true
    },
    {
      "name": "search_challan_number",
      "type": "text",
      "required": true,
      "source": "search_office",
      "description": "Search challan number",
      "review_level": "glance"
    },
    {
      "name": "search_conclusion",
      "type": "text",
      "required": true,
      "source": "drafted",
      "description": "Conclusion of the encumbrance search (e.g. whether any adverse entry was found)",
      "review_level": "must_confirm",
      "auto_confirm": false,
      "draft_blocked_when_open_red_flags": true
    },
    {
      "name": "search_date",
      "type": "date",
      "required": true,
      "source": "search_office",
      "description": "Date of the online search",
      "review_level": "glance"
    },
    {
      "name": "search_period_from_year",
      "type": "number",
      "required": true,
      "source": "search_office",
      "description": "First year covered by the Index-II search",
      "review_level": "glance"
    },
    {
      "name": "search_period_to_year",
      "type": "number",
      "required": true,
      "source": "search_office",
      "description": "Last year covered by the Index-II search",
      "review_level": "glance"
    },
    {
      "name": "search_period_years",
      "type": "number",
      "required": true,
      "source": "search_office",
      "description": "Number of years searched",
      "review_level": "glance"
    },
    {
      "name": "search_receipt_number",
      "type": "text",
      "required": true,
      "source": "search_office",
      "description": "Search receipt number",
      "review_level": "glance"
    },
    {
      "name": "stamp_duty_status",
      "type": "text",
      "required": true,
      "source": "drafted",
      "description": "Q15 stamp duty / e-stamp verification",
      "review_level": "glance"
    },
    {
      "name": "title_status",
      "type": "text",
      "required": true,
      "source": "drafted",
      "description": "Title status printed in the header (e.g. Clear & Marketable)",
      "review_level": "must_confirm",
      "auto_confirm": false,
      "draft_blocked_when_open_red_flags": true
    },
    {
      "name": "transferor_names",
      "type": "text",
      "required": false,
      "source": "extracted",
      "description": "Transferor name(s); 'NA' if none",
      "review_level": "glance"
    },
    {
      "name": "webtop_number",
      "type": "text",
      "required": false,
      "source": "case_intake",
      "description": "Bank WEBTOP/application reference number",
      "review_level": "glance"
    }
  ],
  "loops": [
    {
      "name": "chain_steps",
      "type": "list",
      "item_type": "string",
      "required": true,
      "min_items": 1,
      "source": "drafted",
      "description": "Chain-of-title narration, one paragraph per step",
      "review_level": "glance"
    },
    {
      "name": "documents_at_disbursement",
      "type": "list",
      "item_type": "object",
      "required": false,
      "min_items": 0,
      "source": "extracted",
      "description": "Documents at delivery of pay order/cheque; NONE label prints when empty",
      "item_fields": [
        "description",
        "form"
      ],
      "review_level": "glance"
    },
    {
      "name": "documents_post_disbursement",
      "type": "list",
      "item_type": "object",
      "required": false,
      "min_items": 0,
      "source": "extracted",
      "description": "Documents post-disbursement; NIL label prints when empty",
      "item_fields": [
        "description",
        "form"
      ],
      "review_level": "glance"
    },
    {
      "name": "documents_pre_disbursement",
      "type": "list",
      "item_type": "object",
      "required": false,
      "min_items": 0,
      "source": "extracted",
      "description": "Documents to be collected before disbursal (description, original/copy)",
      "item_fields": [
        "description",
        "form"
      ],
      "review_level": "glance"
    },
    {
      "name": "documents_verified",
      "type": "list",
      "item_type": "object",
      "required": true,
      "min_items": 1,
      "source": "extracted",
      "description": "Documents verified, one full description each",
      "item_fields": [
        "description"
      ],
      "review_level": "glance"
    }
  ]
}