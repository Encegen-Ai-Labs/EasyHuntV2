SUPABASE_URL=URL
SUPABASE_KEY=key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-supabase-project-jwt-secret-key-found-in-settings
$env:ADMIN_EMAIL="admin@example.com"
$env:ADMIN_PASSWORD="admin123"

# Gemini (paid) — document extraction, VLM fallback for handwritten pages,
# and embeddings only. See app/services/llm_extractor.py.
GEMINI_API_KEY=your-gemini-api-key

# Google Cloud Translation API v2/Basic (free tier) — page-text-to-English only.
# Deliberately separate from GEMINI_API_KEY to keep translation off the paid
# extraction model. See app/services/translation_service.py.
GOOGLE_TRANSLATE_API_KEY=your-google-translate-api-key